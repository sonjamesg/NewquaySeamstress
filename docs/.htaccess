Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://newquayseamstress.com/$1 [R=301,L]
RewriteRule ^(default\.php|site\.zip)$ - [R=404,L]
RewriteRule ^wedding-dress-alterations-cornwall/?$ /about/ [R=301,L]
RewriteRule ^suit-tailoring-newquay/?$ /about/ [R=301,L]
RewriteRule ^bespoke-dressmaking-newquay/?$ /about/ [R=301,L]

<IfModule mod_headers.c>
Header always set Strict-Transport-Security "max-age=31536000"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
<FilesMatch "\.(css|js|svg|webp|png|jpg|ico|woff2)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.(html|xml|txt|webmanifest)$">
Header set Cache-Control "public, max-age=600"
</FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain application/manifest+json
</IfModule>
AddType application/manifest+json .webmanifest
